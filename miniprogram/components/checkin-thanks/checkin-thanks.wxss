/* 全屏打卡感谢页 - 黑白简约超写实主义 */
.thanks-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  pointer-events: none;
}

.thanks-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* 内容区域 */
.thanks-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 80rpx;
}

/* 极细横线 - 上 */
.thanks-line {
  width: 80rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-bottom: 80rpx;
}

/* 感谢文字组 */
.thanks-text-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.thanks-prefix,
.thanks-suffix {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 8rpx;
  line-height: 1.8;
}

.thanks-company {
  font-size: 68rpx;
  color: #fff;
  font-weight: 300;
  letter-spacing: 12rpx;
  line-height: 1.4;
  margin: 24rpx 0;
  text-align: center;
}

/* 打卡类型 */
.thanks-type {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
  letter-spacing: 6rpx;
  margin-top: 48rpx;
}

/* 时间 */
.thanks-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 300;
  letter-spacing: 4rpx;
  margin-top: 16rpx;
  font-variant-numeric: tabular-nums;
}

/* 极细横线 - 下 */
.thanks-line-bottom {
  width: 80rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-top: 80rpx;
}

/* 触摸退出提示 */
.thanks-dismiss {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.2);
  font-weight: 300;
  letter-spacing: 4rpx;
}
