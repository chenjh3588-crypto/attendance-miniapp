.company-select-page {
  padding-top: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 32rpx;
}

.company-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  transition: transform 0.2s;
}

.company-item:active {
  transform: scale(0.98);
}

.company-logo-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
  overflow: hidden;
  margin-right: 20rpx;
}

.company-logo-sm image {
  width: 100%;
  height: 100%;
}

.company-item-info {
  flex: 1;
}

.company-item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 6rpx;
}

.company-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

.create-company-btn {
  text-align: center;
  padding: 32rpx;
  color: var(--primary-color);
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 24rpx;
}
