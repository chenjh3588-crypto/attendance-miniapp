.checkin-page {
  padding-top: 0;
  padding-bottom: 40rpx;
}

/* 公司头部 */
.company-header {
  padding: 40rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.company-info {
  display: flex;
  align-items: center;
}

.company-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
}

.company-logo-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.company-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 个人标签入口 */
.profile-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  transition: background 0.2s;
}

.profile-entry:active {
  background: rgba(255, 255, 255, 0.35);
}

.profile-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.profile-avatar-placeholder {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.profile-nickname {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 日期时间卡片 */
.datetime-card {
  text-align: center;
  padding: 40rpx;
}

.date-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.time-text {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-color);
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}

/* 打卡按钮 */
.checkin-actions {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.checkin-btn {
  flex: 1;
  border-radius: 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  color: #fff;
  transition: transform 0.2s, opacity 0.2s;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.checkin-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.checkin-btn.checked {
  background: #e8e8e8 !important;
  color: #999;
  box-shadow: none;
}

.checkin-btn-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.checkin-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.checkin-btn-time {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 位置信息 */
.location-card {
  padding: 24rpx 32rpx;
}

.location-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.location-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 异常卡片 */
.abnormal-card {
  background: #FFF7E6;
  border-left: 6rpx solid var(--warning-color);
}

.abnormal-warning {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--warning-color);
  margin-bottom: 8rpx;
}

.abnormal-reason {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.abnormal-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}
