.guild-page {
  padding-top: 40rpx;
}

/* 选择步骤 */
.hero-section {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.hero-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 28rpx;
  color: var(--text-hint);
}

.action-cards {
  margin-top: 40rpx;
}

.action-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform 0.2s;
}

.action-card:active {
  transform: scale(0.98);
}

.action-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.action-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1.5;
}

.action-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: var(--text-hint);
}

/* 步骤头部 */
.step-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.back-btn {
  font-size: 30rpx;
  color: var(--primary-color);
  padding: 12rpx 20rpx 12rpx 0;
}

.step-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

/* Logo 上传 */
.logo-upload {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin: 0 auto;
}

.logo-preview {
  width: 200rpx;
  height: 200rpx;
}

.logo-placeholder {
  width: 200rpx;
  height: 200rpx;
  background: var(--bg-color);
  border: 2rpx dashed var(--border-color);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.logo-plus {
  font-size: 56rpx;
  color: var(--text-hint);
  line-height: 1;
}

.logo-text {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 主题色选择 */
.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-option {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
  border: 4rpx solid transparent;
}

.color-option.active {
  border-color: var(--text-color);
  transform: scale(1.1);
}

.color-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 邀请码 */
.invite-hint {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.invite-input {
  text-align: center;
  font-size: 40rpx;
  letter-spacing: 16rpx;
  font-weight: 700;
  text-transform: uppercase;
}
