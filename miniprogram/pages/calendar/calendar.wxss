.calendar-page {
  padding-bottom: 40rpx;
}

/* 月份切换 */
.month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.month-nav {
  padding: 12rpx 20rpx;
}

.nav-arrow {
  font-size: 28rpx;
  color: var(--primary-color);
}

.month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-color);
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 6rpx;
}

.dot-normal { background: var(--success-color); }
.dot-late { background: var(--warning-color); }
.dot-early { background: #FA8C16; }
.dot-overtime { background: var(--primary-color); }
.dot-absent { background: var(--danger-color); }

.stat-label {
  font-size: 20rpx;
  color: var(--text-hint);
}

.stat-count {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-top: 2rpx;
}

/* 日历 */
.calendar {
  padding: 16rpx;
}

.week-header {
  display: flex;
  margin-bottom: 8rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 8rpx 0;
}

.week-day.weekend {
  color: var(--danger-color);
}

.week-row {
  display: flex;
}

.day-cell {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  margin: 4rpx;
  position: relative;
  transition: background 0.2s;
}

.day-cell.empty {
  background: transparent;
}

.day-cell.today {
  border: 2rpx solid var(--primary-color);
}

.day-cell.selected {
  background: var(--primary-light);
}

.day-cell.status-normal { background: rgba(82, 196, 26, 0.1); }
.day-cell.status-late { background: rgba(250, 173, 20, 0.1); }
.day-cell.status-early { background: rgba(250, 140, 22, 0.1); }
.day-cell.status-overtime { background: rgba(74, 144, 217, 0.1); }
.day-cell.status-absent { background: rgba(255, 77, 79, 0.1); }

.day-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.day-number {
  font-size: 26rpx;
  color: var(--text-color);
}

.day-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 4rpx;
}

.status-normal .day-status-dot { background: var(--success-color); }
.status-late .day-status-dot { background: var(--warning-color); }
.status-early .day-status-dot { background: #FA8C16; }
.status-overtime .day-status-dot { background: var(--primary-color); }
.status-absent .day-status-dot { background: var(--danger-color); }

/* 详情卡片 */
.detail-card {
  margin-top: 8rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-date {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.detail-body {
  padding-top: 8rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

/* 工作内容 */
.work-content-section {
  padding-top: 8rpx;
}

.edit-btn {
  font-size: 26rpx;
  color: var(--primary-color);
}

.work-content-input {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-color);
  margin-top: 12rpx;
  box-sizing: border-box;
}

.work-content-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding: 16rpx 0;
  min-height: 80rpx;
}

.save-btn {
  margin-top: 16rpx;
  font-size: 28rpx;
  padding: 16rpx;
}

.detail-empty {
  text-align: center;
  padding: 32rpx;
  color: var(--text-hint);
  font-size: 28rpx;
}
