.admin-page {
  padding-top: 0;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.admin-tabs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.admin-tab {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-hint);
  white-space: nowrap;
  border-radius: 8rpx;
  background: var(--card-bg);
}

.admin-tab.active {
  color: var(--primary-color);
  font-weight: 600;
  background: var(--primary-light);
}

.add-btn {
  padding: 12rpx 24rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 员工卡片 */
.employee-card {
  padding: 24rpx 32rpx;
}

.employee-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.employee-detail {
  flex: 1;
  margin-left: 20rpx;
}

.employee-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.employee-meta {
  font-size: 24rpx;
  color: var(--text-hint);
}

.employee-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-btn {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.edit-btn {
  background: var(--primary-light);
  color: var(--primary-color);
}

.delete-btn {
  background: #FFF1F0;
  color: var(--danger-color);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-body {
  margin-bottom: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
}

/* 单选组 */
.radio-group {
  display: flex;
  gap: 16rpx;
}

.radio-item {
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.radio-item.active {
  background: var(--primary-light);
  color: var(--primary-color);
  border-color: var(--primary-color);
}

.picker-field {
  line-height: 88rpx;
  color: var(--text-secondary);
}
