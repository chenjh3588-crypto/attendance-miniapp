/* 邀请码 */
.invite-card {
  text-align: center;
}

.invite-code-display {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: 16rpx;
  margin: 20rpx 0;
}

.invite-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 折叠区头部 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-header .card-title {
  margin-bottom: 0;
}

.expand-icon {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 配置提示 */
.config-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 部门标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.dept-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  color: var(--primary-color);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.dept-remove {
  font-size: 22rpx;
  color: var(--danger-color);
  font-weight: 700;
}

.dept-add {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-dept-btn {
  white-space: nowrap;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

.dept-add .input-field {
  flex: 1;
}

/* 配置行 */
.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.config-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.config-value {
  font-size: 28rpx;
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  border-radius: 8rpx;
}

.config-input {
  width: 200rpx;
  height: 64rpx;
  background: var(--bg-color);
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  text-align: right;
  color: var(--text-color);
}

.config-input.small {
  width: 120rpx;
}

/* 罚款规则 */
.penalty-rule {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.penalty-rule:last-child {
  border-bottom: none;
}

.penalty-rule-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.penalty-switch {
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: #eee;
  color: #999;
}

.penalty-switch.on {
  background: var(--primary-light);
  color: var(--primary-color);
}

.penalty-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

.penalty-mode {
  font-size: 22rpx;
  color: var(--text-hint);
}

.penalty-rate-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.remove-btn {
  font-size: 22rpx;
  color: var(--danger-color);
  padding: 4rpx 12rpx;
  white-space: nowrap;
}

.add-penalty {
  padding-top: 8rpx;
}

/* Wi-Fi */
.wifi-list {
  margin-bottom: 16rpx;
}

.wifi-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.wifi-name {
  font-size: 28rpx;
  color: var(--text-color);
}

/* 定位 */
.location-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.location-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}

.save-all-btn {
  margin: 32rpx 0;
  padding: 28rpx;
  font-size: 32rpx;
}

/* 工资条字段配置 */
.field-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
  padding: 16rpx 0 8rpx;
  border-bottom: 1rpx solid var(--primary-light);
  margin-top: 8rpx;
}

.field-group-title:first-child { margin-top: 0; }

.field-config-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  gap: 12rpx;
}

.field-type-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.type-auto {
  background: #E6F7FF;
  color: #1890FF;
}

.type-manual {
  background: #F6FFED;
  color: #52C41A;
}

.field-label-area {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.field-label-text {
  font-size: 28rpx;
  color: var(--text-color);
}

.field-highlight-icon {
  font-size: 22rpx;
  color: #FAAD14;
}

.field-action-btns {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-hint);
  border-radius: 6rpx;
  background: var(--bg-color);
}

.action-icon.danger {
  color: var(--danger-color);
}

.field-actions-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.field-actions-bar .btn-primary,
.field-actions-bar .btn-secondary {
  flex: 1;
  padding: 16rpx;
  font-size: 26rpx;
}

/* 数据来源选择列表 */
.source-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.source-option {
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background: var(--bg-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid transparent;
}

.source-option.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.source-name {
  font-size: 26rpx;
  color: var(--text-color);
}

.source-type {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 排序按钮 - 复用 */
.order-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

@import '../employees/employees.wxss';
